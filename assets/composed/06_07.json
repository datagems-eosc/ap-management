  "nodes": [
    {
      "id": "c0000000-0000-0000-0000-000000000001",
      "labels": [
        "Analytical_Pattern"
      ],
      "properties": {
        "name": "NL Query and Schema AP",
        "description": "Translates a natural-language query to SQL and independently extracts the DB schema.",
        "process": "query",
        "publishedDate": "2026-06-15"
      }
    },
    {
      "id": "06-op-a",
      "labels": [
        "Text_To_SQL_Operator",
        "Operator"
      ],
      "properties": {
        "name": "Text to SQL",
        "description": "Translates a natural-language string into a safe SQL query.",
        "version": "1.0.0",
        "step": 1,
        "inputs": [
          {
            "name": "nl",
            "type": "string",
            "required": true,
            "default": ""
          }
        ],
        "outputs": [
          {
            "name": "query",
            "type": "string",
            "required": true,
            "default": ""
          }
        ]
      }
    },
    {
      "id": "06-op-b",
      "labels": [
        "Schema_Analyzer_Operator",
        "Operator"
      ],
      "properties": {
        "name": "Schema Analyzer",
        "description": "Connects to the target database and returns a textual summary of its schema.",
        "version": "1.0.0",
        "step": 2,
        "inputs": [
          {
            "name": "database_url",
            "type": "string",
            "required": true,
            "default": ""
          }
        ],
        "outputs": [
          {
            "name": "schema",
            "type": "string",
            "required": true,
            "default": ""
          }
        ]
      }
    },
    {
      "id": "c0000000-0000-0000-0000-000000000002",
      "labels": [
        "ResultType",
        "string"
      ],
      "properties": {
        "name": "query"
      }
    },
    {
      "id": "c0000000-0000-0000-0000-000000000003",
      "labels": [
        "ResultType",
        "string"
      ],
      "properties": {
        "name": "schema"
      }
    },
    {
      "id": "07-op",
      "labels": [
        "SQL_With_Context_Operator",
        "Operator"
      ],
      "properties": {
        "name": "SQL With Context",
        "description": "Produces a plain-language explanation of an SQL query given the target schema.",
        "version": "1.0.0",
        "step": 1,
        "inputs": [
          {
            "name": "query",
            "type": "string",
            "required": true,
            "default": ""
          },
          {
            "name": "schema",
            "type": "string",
            "required": true,
            "default": ""
          }
        ],
        "outputs": [
          {
            "name": "explanation",
            "type": "string",
            "required": true,
            "default": ""
          }
        ]
      }
    }
