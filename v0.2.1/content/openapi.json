        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatePayload"
                }
              }
            }
          },
          "500": {
            "description": "Database error or unexpected server error"
