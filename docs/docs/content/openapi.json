{
  "openapi": "3.1.0",
  "info": {
    "title": "Analytical Pattern Management API",
    "description": "API to manage AP",
    "version": "0.4.5"
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Index",
        "operationId": "index__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/analytical-patterns/compose": {
      "post": {
        "tags": [
          "analytical patterns"
        ],
        "summary": "Compose Aps",
        "description": "Create a new AnalyticalPattern in the MoMa graph repository.\n\nThe ``input`` edges of the AP **must** reference Data nodes that belong\nto an existing dataset, and the caller must be able to **browse** those\ndatasets.  The AP cannot create Dataset nodes itself.",
        "operationId": "compose_aps_analytical_patterns_compose_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ComposePayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Composed AnalyticalPattern returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response 200 Compose Aps Analytical Patterns Compose Post"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or composition is not possible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected internal error during composition",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ComposePayload": {
        "properties": {
          "ap1": {
            "additionalProperties": true,
            "type": "object",
            "title": "Ap1"
          },
          "ap2": {
            "additionalProperties": true,
            "type": "object",
            "title": "Ap2"
          }
        },
        "type": "object",
        "required": [
          "ap1",
          "ap2"
        ],
        "title": "ComposePayload"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}