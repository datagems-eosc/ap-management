MOMA_VERSION=v2.6.0
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# AUTH configuration
OIDC_ISSUER=
OIDC_AUDIENCE=
JWKS_TTL_SECONDS=300
PERMISSIONS_GATEWAY_URL=% 

# LLM configuration
LLM_API_BASE=
LLM_API_KEY=
LLM_API_MODEL=
LLM_SSL_VERIFY=false

# Magic operator configuration
# Name of the operator node the planner emits for a step no catalogued AP covers.
# The AP Executor slugifies this into the Consul service name it resolves the operator
# under ("Magic Operator" -> "magic-operator"), so it must match the name the deployed
# magic operator registers itself with.
MAGIC_OPERATOR_NAME="Magic Operator"
# Pins the Consul lookup to Service.Meta.version. Leave empty on Kubernetes:
# consul-k8s Service Sync cannot set that field, so a pinned version resolves nothing.
MAGIC_OPERATOR_VERSION=
